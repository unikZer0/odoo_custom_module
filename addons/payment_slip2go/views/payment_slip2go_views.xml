
<odoo>
    <record id="view_slip2go_transaction_tree" model="ir.ui.view">
        <field name="name">slip2go.transaction.tree</field>
        <field name="model">slip2go.transaction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="state"/>
